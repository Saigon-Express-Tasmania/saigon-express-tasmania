# Supabase Configuration for Admin Dashboard
# Get these values from your Supabase project settings at https://supabase.com
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

VITE_CACHE_REVALIDATE_SECRET=change-me-in-production

# Cloudflare R2 (S3-compatible) media storage
# Account ID: Cloudflare dashboard → R2 → Overview
# API tokens: R2 → Manage R2 API Tokens (Object Read & Write)
VITE_R2_ACCOUNT_ID=your_cloudflare_account_id
VITE_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
VITE_R2_BUCKET=saigon-express-tasmania
# Public base URL or custom domain for objects (no trailing slash)
# e.g. https://cdn.saigonexpresstasmania.com.au
VITE_R2_PUBLIC_URL=https://your-r2-public-or-custom-domain
