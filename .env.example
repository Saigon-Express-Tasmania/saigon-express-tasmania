# Server-only
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://saigonexpress.com.au
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-H9D1Z5Y4FK
CACHE_REVALIDATE_SECRET=change-me-in-production

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Blog view counting (server-only IP hashing salt).
BLOG_VIEW_IP_SALT=change-me-in-production
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=your-supabase-storage-bucket
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET_FOR_CUSTOMER=your-supabase-storage-bucket-for-customer

# Stripe mode for checkout (test | live). Keys live in Supabase Edge Function secrets:
# STRIPE_TEST_SECRET_KEY, STRIPE_LIVE_SECRET_KEY, STRIPE_TEST_WEBHOOK_KEY, STRIPE_LIVE_WEBHOOK_KEY
NEXT_PUBLIC_STRIPE_MODE=test

# Webhook URL: https://<project-ref>.supabase.co/functions/v1/stripe-webhook
